---
import { CATEGORIES, SITE_TITLE } from '../consts';

const navLinks = [
  { href: '/', label: 'Home' },
  ...CATEGORIES.map((c) => ({ href: `/${c.slug}`, label: c.label })),
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-bg">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="text-xl font-extrabold tracking-tight text-ink">
      {SITE_TITLE}
    </a>

    <nav class="hidden items-center gap-6 sm:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-semibold transition-colors',
              isActive(link.href) ? 'text-ink underline underline-offset-4' : 'text-muted hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/search"
        class="border-2 border-ink px-3 py-1.5 text-sm font-semibold text-ink hover:bg-ink hover:text-bg"
        aria-label="검색"
      >
        검색
      </a>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="border-2 border-ink px-3 py-1.5 text-sm font-semibold sm:hidden"
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      메뉴
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t-2 border-ink px-4 py-3 sm:hidden">
    <ul class="flex flex-col gap-3">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block text-sm font-semibold',
                isActive(link.href) ? 'text-ink underline underline-offset-4' : 'text-muted',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/search" class="block text-sm font-semibold text-muted">
          검색
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(isHidden)));
  });
</script>
