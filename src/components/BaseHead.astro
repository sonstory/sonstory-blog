---
import { ADSENSE_CLIENT_ID, SITE_DESCRIPTION, SITE_TITLE, SITE_VERIFICATION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 글 상세 페이지 등 canonical URL을 명시하고 싶을 때 */
  canonicalPath?: string;
  /** OG type. 글은 'article', 나머지는 'website' */
  type?: 'website' | 'article';
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = '/og-default.png',
  canonicalPath,
  type = 'website',
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} — AI 공부 기록`;
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
<meta name="generator" content={Astro.generator} />

<link rel="preload" href="/fonts/pretendard/PretendardVariable.subset.0.woff2" as="font" type="font/woff2" crossorigin />

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{SITE_VERIFICATION.google && <meta name="google-site-verification" content={SITE_VERIFICATION.google} />}
{SITE_VERIFICATION.naver && <meta name="naver-site-verification" content={SITE_VERIFICATION.naver} />}

{
  ADSENSE_CLIENT_ID && (
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`}
      crossorigin="anonymous"
    />
  )
}
