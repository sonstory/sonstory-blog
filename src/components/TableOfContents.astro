---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav aria-label="목차" class="sticky top-24 hidden max-h-[calc(100vh-8rem)] overflow-y-auto lg:block">
      <p class="text-xs font-bold uppercase tracking-wide text-muted">목차</p>
      <ul class="mt-3 flex flex-col gap-2 border-l-2 border-ink pl-4 text-sm">
        {items.map((h) => (
          <li class:list={[h.depth === 3 && 'pl-3']}>
            <a href={`#${h.slug}`} data-toc-link data-toc-slug={h.slug} class="block text-muted hover:text-ink">
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const headingEls = Array.from(links)
      .map((link) => document.getElementById(link.dataset.tocSlug ?? ''))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (slug: string | null) => {
      links.forEach((link) => {
        const isActive = link.dataset.tocSlug === slug;
        link.classList.toggle('text-ink', isActive);
        link.classList.toggle('font-semibold', isActive);
        link.classList.toggle('text-muted', !isActive);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: '-96px 0px -70% 0px', threshold: 0 }
    );

    headingEls.forEach((el) => observer.observe(el));
  }
</script>
