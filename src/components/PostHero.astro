---
import type { Category } from '../consts';

interface Props {
  title: string;
  description: string;
  category: Category;
  tags: string[];
  pubDate: Date;
  updatedDate?: Date;
}

const { title, description, category, tags, pubDate, updatedDate } = Astro.props;
---

<div class="border-[3px] border-ink p-6 sm:p-8">
  <a
    href={`/${category.slug}`}
    class="inline-block px-2 py-1 text-sm font-bold uppercase tracking-wide text-white"
    style={`background:${category.accent}`}
  >
    {category.label}
  </a>
  <h1 class="mt-2 text-2xl font-extrabold sm:text-4xl">{title}</h1>
  <p class="mt-3 text-muted">{description}</p>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <p class="text-sm text-muted">
      {pubDate.toLocaleDateString('ko-KR')}
      {updatedDate && <span> · {updatedDate.toLocaleDateString('ko-KR')} 수정</span>}
    </p>
    {tags.map((tag) => <span class="border border-ink px-1.5 py-0.5 text-[11px] font-medium text-muted">#{tag}</span>)}
  </div>
</div>
