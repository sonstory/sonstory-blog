---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="전체 글" description="Sonstory에 발행된 모든 글 목록" canonicalPath="/posts">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="text-sm font-bold uppercase tracking-wide text-muted">Archive</p>
    <h1 class="mt-2 text-3xl font-extrabold">전체 글</h1>
    <p class="mt-6 text-sm font-semibold text-muted">{posts.length}편</p>

    {
      posts.length > 0 ? (
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-sm text-muted">아직 발행된 글이 없습니다.</p>
      )
    }
  </section>
</BaseLayout>
