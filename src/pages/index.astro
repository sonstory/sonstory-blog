---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { CATEGORIES } from '../consts';
import { getPublishedPosts, getPostsByCategory, getTagCounts } from '../lib/posts';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 6);
const tags = getTagCounts(posts).slice(0, 20);
---

<BaseLayout>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <section class="pt-6 pb-8">
      <h1 class="text-3xl font-extrabold text-[#2452b8] sm:text-4xl">안녕하세요👋</h1>
      <p class="mt-4 max-w-[46rem] text-muted">
        제조 기업에서 연구원으로 일하며 다양한 AI 프로젝트들을 기획 및 개발하고, 전사적인 AI 전환을 추진하고 있습니다.
        <br />
        이 블로그는 퇴근 후 관심 있는 AI 분야를 다양하게 공부하고, 저만의 언어로 정리하며 성장하기 위한 공간입니다.
        <br />
        작성된 포스트에 대해 궁금하거나 잘못된 부분이 있다면 아래 링크들을 통해 연락 주시면 감사하겠습니다.
      </p>
      <div class="mt-5">
        <SocialLinks />
      </div>
      <p class="mt-6 text-sm font-semibold text-muted">지금까지 쓴 글 {posts.length}편</p>
    </section>

    <section class="border-t-2 border-ink pt-8 pb-10">
      <div class="flex items-baseline justify-between">
        <h2 class="text-xl font-extrabold">최근 포스트</h2>
        <a href="/posts" class="text-sm font-semibold text-muted hover:text-ink">
          전체 보기 &rarr;
        </a>
      </div>
      {
        recentPosts.length > 0 ? (
          <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {recentPosts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="mt-6 text-sm text-muted">아직 발행된 글이 없습니다.</p>
        )
      }
    </section>

    <section class="pb-10">
      <h2 class="text-xl font-extrabold">카테고리별</h2>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          CATEGORIES.map((category) => {
            const categoryPosts = getPostsByCategory(posts, category.slug).slice(0, 3);
            return (
              <div class="border-[3px] border-ink bg-bg">
                <div class="h-1.5" style={`background:${category.accent}`} />
                <div class="p-5">
                  <h3
                    class="inline-block px-3 py-1 text-base font-extrabold text-white"
                    style={`background:${category.accent}`}
                  >
                    {category.label}
                  </h3>
                  <p class="mt-2 text-sm text-muted">{category.description}</p>
                  {categoryPosts.length > 0 ? (
                    <ul class="mt-4 flex flex-col gap-3">
                      {categoryPosts.map((post) => (
                        <li>
                          <a href={`/${post.id}`} class="block text-sm font-semibold leading-snug text-ink hover:underline">
                            {post.data.title}
                          </a>
                          <p class="mt-0.5 text-xs text-muted">{post.data.pubDate.toLocaleDateString('ko-KR')}</p>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="mt-4 text-sm text-muted">아직 글이 없습니다.</p>
                  )}
                  <a href={`/${category.slug}`} class="mt-4 inline-block text-sm font-semibold text-muted hover:text-ink">
                    전체 보기 &rarr;
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    {
      tags.length > 0 && (
        <section class="pb-10">
          <h2 class="text-xl font-extrabold">키워드</h2>
          <div class="mt-6">
            <TagList tags={tags} />
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
