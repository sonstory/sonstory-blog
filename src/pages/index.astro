---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagList from '../components/TagList.astro';
import { CATEGORIES, SITE_DESCRIPTION } from '../consts';
import { getPublishedPosts, getPostsByCategory, getTagCounts } from '../lib/posts';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 6);
const tags = getTagCounts(posts).slice(0, 20);
---

<BaseLayout>
  <section>
    <div class="mx-auto max-w-6xl border-b-2 border-ink px-4 py-16 sm:px-6">
      <h1 class="text-3xl font-extrabold sm:text-4xl">Sonstory</h1>
      <p class="mt-3 max-w-xl text-muted">{SITE_DESCRIPTION}</p>
      <p class="mt-6 text-sm font-semibold text-muted">지금까지 쓴 글 {posts.length}편</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-extrabold">최근 포스팅</h2>
      <a href="/posts" class="text-sm font-semibold text-muted hover:text-ink">
        전체 보기 &rarr;
      </a>
    </div>
    {
      recentPosts.length > 0 ? (
        <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {recentPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-sm text-muted">아직 발행된 글이 없습니다.</p>
      )
    }
  </section>

  <section>
    <div class="mx-auto max-w-6xl border-y-2 border-ink px-4 py-16 sm:px-6">
      <h2 class="text-xl font-extrabold">카테고리별</h2>
      <div class="mt-6 flex flex-col gap-10">
        {
          CATEGORIES.map((category) => {
            const categoryPosts = getPostsByCategory(posts, category.slug).slice(0, 3);
            return (
              <div class="border-[3px] border-ink bg-bg">
                <div class="h-1.5" style={`background:${category.accent}`} />
                <div class="p-6">
                  <div class="flex items-baseline justify-between">
                    <h3
                      class="inline-block px-3 py-1 text-lg font-extrabold text-white"
                      style={`background:${category.accent}`}
                    >
                      {category.label}
                    </h3>
                    <a href={`/${category.slug}`} class="text-sm font-semibold text-muted hover:text-ink">
                      전체 보기 &rarr;
                    </a>
                  </div>
                  <p class="mt-1 text-sm text-muted">{category.description}</p>
                  {categoryPosts.length > 0 ? (
                    <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-3">
                      {categoryPosts.map((post) => (
                        <PostCard post={post} showCategory={false} />
                      ))}
                    </div>
                  ) : (
                    <p class="mt-5 text-sm text-muted">아직 글이 없습니다.</p>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  {
    tags.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <h2 class="text-xl font-extrabold">키워드</h2>
        <div class="mt-6">
          <TagList tags={tags} />
        </div>
      </section>
    )
  }
</BaseLayout>
