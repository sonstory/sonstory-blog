---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, getCategory } from '../../consts';
import { getPublishedPosts, getPostsByCategory } from '../../lib/posts';

export async function getStaticPaths() {
  // consts.ts에 정의된 3개 카테고리만 반환한다. 실제 글 존재 여부와 무관하게
  // 카테고리 페이지 자체는 항상 존재해야 하며, 임의의 [category] 값으로
  // 페이지가 생성되는 것을 막는다.
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
  }));
}

const { category: categorySlug } = Astro.params;
const category = getCategory(categorySlug)!;
const posts = getPostsByCategory(await getPublishedPosts(), category.slug);
---

<BaseLayout title={category.label} description={category.description} canonicalPath={`/${category.slug}`}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="text-sm font-bold uppercase tracking-wide" style={`color:${category.accent}`}>Category</p>
    <h1 class="mt-2 text-3xl font-extrabold">{category.label}</h1>
    <p class="mt-3 text-muted">{category.description}</p>
    <p class="mt-6 text-sm font-semibold text-muted">{posts.length}편</p>

    {
      posts.length > 0 ? (
        <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-sm text-muted">아직 발행된 글이 없습니다.</p>
      )
    }
  </section>
</BaseLayout>
